# J.A.R.V.I.S. environment example
# Copy this file to ".env" and replace placeholder values with local secrets.
# Do not commit ".env", tokens, caches, voice profiles, memory DBs, or logs.

# -------------------------------
# AI providers
# -------------------------------
# Gemini is preferred when configured. Groq can be primary or automatic
# fallback. GOOGLE_API_KEY remains a compatible Gemini-key alias.
GEMINI_API_KEY=""
GROQ_API_KEY=""
JARVIS_LLM_PROVIDER=""
JARVIS_GEMINI_MODEL="gemini-2.5-flash"
# Second Gemini model tried when the main one hits its (per-model) free quota; "none" disables.
JARVIS_GEMINI_BACKUP_MODEL="gemini-3.1-flash-lite"
JARVIS_GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
# Live voice personality: Charon (calm/formal/JARVIS style), Puck (upbeat), Fenrir (dynamic), Aoede, Kore
JARVIS_GEMINI_LIVE_VOICE="Charon"
JARVIS_GEMINI_VISION_MODEL="gemini-2.5-flash"
JARVIS_GROQ_MODEL="openai/gpt-oss-120b"
# Local AI (Ollama, no key, private). Install Ollama, then e.g. `ollama pull qwen2.5:3b`.
# JARVIS_AI_MODE: cloud_first (Gemini -> Groq -> Ollama), local_first
# (Ollama -> cloud) or local_only (nothing leaves this PC).
OLLAMA_MODEL=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_TIMEOUT_SECONDS="60"
# Local reasoning models (qwen3.5) are told not to think first, which keeps voice replies fast.
# Set to default to let them reason (slow: ~100 s on a 4 GB GPU).
OLLAMA_REASONING="none"
JARVIS_AI_MODE="cloud_first"
JARVIS_GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# Stable core mode is the default. It keeps chat, local voice input, Piper TTS,
# basic memory, Spotify, and the web UI while skipping heavy optional services.
JARVIS_CORE_MODE="true"
# Voice biometrics are experimental and disabled unless explicitly set true.
JARVIS_VOICE_ID_ENABLED=""
JARVIS_ALLOW_GUEST_MODE="false"
JARVIS_RAG_ENABLED=""
JARVIS_VISION_ENABLED=""
JARVIS_PLUGINS_ENABLED=""
JARVIS_BRIEFING_ENABLED=""
JARVIS_TELEGRAM_ENABLED=""
JARVIS_MONITORING_ENABLED=""

# Hugging Face is optional for some local model downloads/caches.
HF_TOKEN=""
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# -------------------------------
# Public APIs and integrations
# -------------------------------
NEWSAPI_KEY=""
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""
BRAVE_API_KEY=""
TAVILY_API_KEY=""
YOUTUBE_API_KEY=""

# Telegram bot is optional. Incoming bot access should be limited to your chat ID.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# Spotify is optional.
# If you already authenticated before changing scopes, delete
# spotify-oauth-cache from the runtime cache directory and authenticate again.
SPOTIPY_CLIENT_ID=""
SPOTIPY_CLIENT_SECRET=""
SPOTIPY_REDIRECT_URI="http://127.0.0.1:8888/callback"
# auto uses a valid cached Web API token and otherwise controls Spotify Desktop.
# api forces Spotipy/OAuth. desktop never starts OAuth during playback.
SPOTIFY_PLAYBACK_MODE="auto"
SPOTIFY_DESKTOP_START_TIMEOUT="20"
SPOTIFY_DESKTOP_ACTION_TIMEOUT="8"
SPOTIFY_MARKET=""
SPOTIFY_MODO_SIMILARES="hybrid"
SPOTIFY_AUTO_SHUFFLE="false"
# Enable only for an existing Spotify extended-quota application. Development
# mode applications cannot use Recommendations, Audio Features, or Related Artists.
SPOTIFY_EXTENDED_QUOTA_MODE="false"
SPOTIFY_AUTOMIX_PLAYLIST_NAME="JARVIS AutoMix"

# -------------------------------
# Local security
# -------------------------------
# Set this before enabling LAN access or sharing a machine with untrusted users.
# Protected HTTP and WebSocket routes require it when configured. Explicit API
# clients use X-JARVIS-API-TOKEN (or the documented WebSocket token parameter);
# the loopback UI receives a derived HttpOnly cookie, never the raw token.
JARVIS_API_TOKEN=""
JARVIS_CORS_ORIGINS="http://127.0.0.1:5002,http://localhost:5002"
# Arbitrary terminal execution and text-file writes are absent from the normal
# tool catalog. Enabling them is advanced/unsafe and still requires confirmation.
JARVIS_SYSTEM_TOOLS_ENABLED="false"
# Semicolon-separated on Windows; colon-separated on macOS/Linux. When empty,
# text writes are limited to JARVIS_DESKTOP_HOME or the user's Desktop.
JARVIS_FILE_WRITE_ROOTS=""
# File management tools (create folder, copy, move, rename, delete to Recycle
# Bin, organize). Confined to JARVIS_FILE_WRITE_ROOTS; move/rename/delete/
# organize still require explicit confirmation. Does not enable the terminal.
JARVIS_FILE_TOOLS_ENABLED="false"
# Reply language: auto mirrors each message; Tamil script is answered in
# Thanglish. Fixed values: en, ta (Tamil script), thanglish, es.
JARVIS_RESPONSE_LANGUAGE="auto"
# Private mode: when true, nothing new is saved to long-term memory (also
# switchable at runtime: "private mode on" / POST /api/security/private-mode).
JARVIS_PRIVATE_MODE="false"
# Offline "Hey Jarvis" (requirements-optional.txt). 0.1-0.95; higher = fewer false triggers.
JARVIS_WAKE_WORD_THRESHOLD="0.5"
JARVIS_WAKE_WORD_COOLDOWN="2.0"

# -------------------------------
# Runtime paths
# -------------------------------
# Mutable data defaults to the platform application-data directory:
# Windows: %LOCALAPPDATA%\Jarvis
# macOS: ~/Library/Application Support/Jarvis
# Linux: ${XDG_DATA_HOME:-~/.local/share}/jarvis
# JARVIS_DATA_DIR is the preferred full override. JARVIS_RUNTIME_DIR remains a
# compatible alias for existing installations.
JARVIS_DATA_DIR=""
JARVIS_RUNTIME_DIR=""
JARVIS_DB_PATH=""
JARVIS_FAISS_DIR=""
JARVIS_CACHE_DIR=""
JARVIS_HF_CACHE=""
JARVIS_LOG_DIR=""
JARVIS_DESKTOP_HOME=""
JARVIS_DESKTOP_ORIGIN="http://localhost:5002"
JARVIS_WEBVIEW_STORAGE=""

# Unified readable diagnostics. This file contains conversation text, frontend
# events, tool activity, and backend output. Keep it private.
JARVIS_UNIFIED_LOG_ENABLED="true"
JARVIS_UNIFIED_LOG_MAX_BYTES="5242880"
JARVIS_UNIFIED_LOG_BACKUP_COUNT="3"

# -------------------------------
# Voice, audio, and TTS
# -------------------------------
JARVIS_MAX_AUDIO_BYTES="12582912"
JARVIS_MAX_REQUEST_BYTES="12582912"
# Live WebSocket transport budgets (bytes unless noted otherwise).
# Gemini Live reconnects as a new provider session with bounded local context;
# native provider session resumption is deliberately not configurable.
JARVIS_LIVE_WS_MESSAGE_BYTES="2097152"
JARVIS_LIVE_AUDIO_CHUNK_BYTES="65536"
JARVIS_LIVE_AUDIO_QUEUE_BYTES="524288"
JARVIS_LIVE_AUDIO_QUEUE_CHUNKS="64"
JARVIS_LIVE_IMAGE_FRAME_BYTES="1572864"
JARVIS_LIVE_IMAGE_QUEUE_BYTES="4194304"
JARVIS_LIVE_IMAGE_QUEUE_FRAMES="10"
JARVIS_LIVE_USER_TEXT_CHARS="16000"
JARVIS_LIVE_SETUP_TIMEOUT_SECONDS="10"
JARVIS_LIVE_RECONNECT_ATTEMPTS="3"
JARVIS_LIVE_RECONNECT_BASE_SECONDS="0.5"
JARVIS_LIVE_RECONNECT_MAX_SECONDS="4"
JARVIS_LIVE_STABLE_CONNECTION_SECONDS="5"
JARVIS_LIVE_RECENT_TURNS="6"
JARVIS_LIVE_CONTEXT_CHARS="6000"
JARVIS_LIVE_INPUT_CHUNK_MS="20"
JARVIS_LIVE_PLAYBACK_QUEUE_MS="60000"
JARVIS_LIVE_MAX_AUDIO_DROPS="25"
JARVIS_LIVE_AUTO_FALLBACK_ENABLED="true"
JARVIS_TTS_MAX_CHARS="420"
# Piper model filename relative to models/, or an absolute path. Use forward
# slashes (C:/...) because backslashes inside quotes are read as escapes.
JARVIS_TTS_MODEL_EN=""
JARVIS_TTS_MODEL_ES=""
# No Tamil Piper voice is bundled; Tamil mode keeps the English local voice
# unless this points at a Tamil-capable Piper .onnx model you provide.
JARVIS_TTS_MODEL_TA=""
# Spoken replies: auto = natural Gemini voice when a key is set (free-tier quota
# is small; JARVIS falls back to Piper for 10 minutes after a quota error),
# piper = always local, edge = only the free Edge voice (no key, no payment; Tamil ta-IN-PallaviNeural,
# Indian English en-IN-NeerjaNeural; needs `pip install edge-tts` and FFmpeg; text goes to Microsoft, so it is
# off in local_only mode). auto order: Gemini -> Edge -> Piper.
JARVIS_TTS_PROVIDER="auto"
JARVIS_EDGE_TTS_VOICE=""
JARVIS_EDGE_TTS_VOICE_TA=""
JARVIS_STT_PROVIDER="auto"
JARVIS_GROQ_STT_MODEL="whisper-large-v3-turbo"
JARVIS_LOCAL_STT_ENABLED="true"
JARVIS_STT_TIMEOUT_SECONDS="20"
JARVIS_WHISPER_MODEL="medium"
# Speech-to-text language: empty = follow the UI language, "auto" = detect (mixed Tamil/English), or en / ta.
JARVIS_STT_LANGUAGE=""
JARVIS_WHISPER_DEVICE="cpu"
JARVIS_WHISPER_COMPUTE_TYPE="int8"
JARVIS_WHISPER_BEAM_SIZE="1"
VOICE_ID_THRESHOLD="0.35"
VOICE_ID_TOP2_GAP="0.05"
VOICE_ID_OWNER_THRESHOLD="0.32"
VOICE_ID_OWNER_OVERRIDE="0.58"
JARVIS_VOICE_HINT_MIN_CONFIDENCE="0.58"
JARVIS_BROWSER_MODE="system"
# Automation browser: empty = Playwright Chromium if downloaded, else installed Edge, else Chrome.
JARVIS_BROWSER_CHANNEL=""
JARVIS_BROWSER_HEADLESS="false"
# Reminders wait during quiet hours (alarms and timers still ring). Empty = off.
JARVIS_QUIET_HOURS=""
# Seconds the launcher waits for the core after login (slow right after Windows starts).
JARVIS_BACKEND_START_TIMEOUT="300"
ESPEAK_ROOT="C:\\Program Files\\eSpeak NG"
JARVIS_USE_RVC="false"
# Optional RVC voice conversion. Only used when JARVIS_USE_RVC=true and rvc-python is installed.
RVC_MODEL_PATH=""
RVC_INDEX_PATH=""

# -------------------------------
# Assistant behavior
# -------------------------------
# always asks the configured LLM to validate every request, hybrid keeps
# deterministic fast paths, and offline never invokes an LLM.
JARVIS_REASONING_MODE="always"
# Public-IP geolocation is disabled by default for privacy. When enabled it uses
# HTTPS providers, single-flight requests, and a negative-result cooldown.
JARVIS_IP_GEOLOCATION_ENABLED="false"
JARVIS_IP_GEOLOCATION_COOLDOWN_SECONDS="300"
JARVIS_DEFAULT_LAT=""
JARVIS_DEFAULT_LON=""
JARVIS_AUTOCURACION=""
JARVIS_PROACTIVE=""
JARVIS_PROACTIVE_COOLDOWN="600"
JARVIS_STRICT_WEB_SEARCH="false"

# Safety limit for local FAISS files.
JARVIS_MAX_FAISS_FILE_BYTES="268435456"

# Email without Google Cloud: Gmail app password (Google Account > Security > 2-Step Verification > App passwords).
# JARVIS reads unread mail read-only and sends only after you approve each message. Never commit the real value.
JARVIS_MAIL_ADDRESS=""
JARVIS_MAIL_APP_PASSWORD=""
JARVIS_MAIL_IMAP_HOST="imap.gmail.com"
JARVIS_MAIL_SMTP_HOST="smtp.gmail.com"
JARVIS_MAIL_SMTP_PORT="587"
